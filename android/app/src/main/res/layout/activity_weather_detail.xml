<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2196F3"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDetailCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="天气详情"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Body: 详情内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 综合空气质量评估 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="综合空气质量评估"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/tvAssessment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="获取中..."
                        android:textSize="16sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 详细数据 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="详细数据"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TableRow android:padding="8dp">
                            <TextView android:text="AQI指数:" android:layout_width="0dp" android:layout_weight="1"/>
                            <TextView android:id="@+id/tvDetailAqi" android:layout_width="0dp" android:layout_weight="1"/>
                        </TableRow>

                        <TableRow android:padding="8dp">
                            <TextView android:text="空气质量:" android:layout_width="0dp" android:layout_weight="1"/>
                            <TextView android:id="@+id/tvDetailAirQuality" android:layout_width="0dp" android:layout_weight="1"/>
                        </TableRow>

                        <TableRow android:padding="8dp">
                            <TextView android:text="PM2.5:" android:layout_width="0dp" android:layout_weight="1"/>
                            <TextView android:id="@+id/tvDetailPm25" android:layout_width="0dp" android:layout_weight="1"/>
                        </TableRow>

                        <TableRow android:padding="8dp">
                            <TextView android:text="PM10:" android:layout_width="0dp" android:layout_weight="1"/>
                            <TextView android:id="@+id/tvDetailPm10" android:layout_width="0dp" android:layout_weight="1"/>
                        </TableRow>

                        <TableRow android:padding="8dp">
                            <TextView android:text="天气:" android:layout_width="0dp" android:layout_weight="1"/>
                            <TextView android:id="@+id/tvDetailWeather" android:layout_width="0dp" android:layout_weight="1"/>
                        </TableRow>

                        <TableRow android:padding="8dp">
                            <TextView android:text="温度:" android:layout_width="0dp" android:layout_weight="1"/>
                            <TextView android:id="@+id/tvDetailTemperature" android:layout_width="0dp" android:layout_weight="1"/>
                        </TableRow>

                        <TableRow android:padding="8dp">
                            <TextView android:text="湿度:" android:layout_width="0dp" android:layout_weight="1"/>
                            <TextView android:id="@+id/tvDetailHumidity" android:layout_width="0dp" android:layout_weight="1"/>
                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 健康建议 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="健康建议"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <TextView
                        android:id="@+id/tvHealthAdvice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="获取中..."
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 折线图占位 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="温湿度趋势"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>