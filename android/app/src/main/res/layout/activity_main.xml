<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="?attr/pageBackground">

    <!-- 顶栏：城市 + 搜索 + 刷新 + 主题 -->
    <include layout="@layout/header_bar" />

    <!-- 三页容器（今天 / 空气质量 / 趋势） -->
    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- 首页「今天」整屏动效天空背景：浮于最底层，仅今天页透出 -->
        <com.smog.weatherapp.WeatherSceneView
                android:id="@+id/weatherScene"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:visibility="gone" />

        <include layout="@layout/page_today" />

        <include layout="@layout/page_air" />

        <include layout="@layout/page_trend" />

        <!-- 错误/重试浮层：数据完全加载失败且无缓存可显示时出现（居中盖在三页之上） -->
        <LinearLayout
                android:id="@+id/errorPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/cardBackground"
                android:elevation="6dp"
                android:padding="26dp"
                android:visibility="gone">

            <TextView
                    android:id="@+id/errorMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="?attr/textSecondary"
                    android:paddingBottom="16dp"
                    android:text="@string/error_load_failed_default" />

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelRetry"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:textColor="?attr/textSecondary"
                        android:text="@string/action_cancel" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_retry" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 底部导航 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/cardBackground"
            android:elevation="10dp"
            app:menu="@menu/menu_bottom"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/bottom_tint"
            app:itemTextColor="@color/bottom_tint" />
</LinearLayout>
