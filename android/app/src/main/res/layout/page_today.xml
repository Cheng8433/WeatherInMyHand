<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/scrollToday"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <!-- 背景留空透出 weatherScene 动效天空 -->

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

        <!-- ===== Hero：大 emoji + 大温度 ===== -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/glassCard"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="22dp"
                    android:paddingBottom="22dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                <TextView
                        android:id="@+id/tvWeatherEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_emoji_placeholder"
                        android:textSize="64sp"
                        android:gravity="center" />

                <TextView
                        android:id="@+id/tvWeatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="17sp"
                        android:textColor="?attr/textPrimary"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                    <TextView
                            android:id="@+id/tvTempNum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="84sp"
                            android:textStyle="bold"
                            android:textColor="?attr/textPrimary" />

                    <TextView
                            android:id="@+id/tvTempUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="°C"
                            android:textSize="28sp"
                            android:textColor="?attr/textPrimary"
                            android:layout_marginBottom="18dp"
                            android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                        android:id="@+id/tvHeroSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondary"
                        android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 实时数据网格 ===== -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/glassCard"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/textSecondary"
                app:strokeWidth="0dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_real_time"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimary"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp" />

                <!-- row1 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMFeels"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_feels"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_humidity"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- row2 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMCloud"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_cloud"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMVis"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_vis"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- row3 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMPressure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_pressure"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMPrecip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_precip"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- row4 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMDew"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_dew"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="10dp">

                        <TextView
                                android:id="@+id/tvMWindSp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="?attr/textPrimary" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today_wind_speed"
                                android:textSize="12sp"
                                android:textColor="?attr/textSecondary"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 风 ===== -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="?attr/glassCard"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_wind_card"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimary" />

                <TextView
                        android:id="@+id/tvWindMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="?attr/textPrimary"
                        android:layout_marginTop="6dp" />

                <TextView
                        android:id="@+id/tvWindSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="14sp"
                        android:textColor="?attr/textSecondary"
                        android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 数据来源标注（合规：标明天气数据供应商） ===== -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/source_qweather_footer"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:alpha="0.7" />

        <!-- ===== 数据时效标注：降级/离线时把「这数据有多旧」明写出来 ===== -->
        <TextView
                android:id="@+id/tvDataTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/data_time_unknown"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary"
                android:alpha="0.7" />
    </LinearLayout>
</ScrollView>
