<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- 定位（运行时申请）+ 联网（冷启动、搜索、定位均需） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weather.Sky"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:label,android:allowBackup,android:usesCleartextTraffic,android:networkSecurityConfig">

        <!--
            合规说明：
            1) allowBackup=false：App 不建账号、本地只存天气/搜索缓存，关掉备份以免位置等
               本地数据被 adb 备份提取。换机无账号可迁，重搜即可。
            2) usesCleartextTraffic=false + tools:replace：走 HTTPS 后显式关闭明文，并压掉
               依赖库可能带来的 cleartext 合并值。后端为 IP 证书(ZeroSSL)：
               https://118.178.147.156/api/（2026-12-07 到期，属 90 天短证书，需在到期前续签）。
            3) 定位/网络权限均声明，无多余项。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 隐私政策 / 关于：应用内页面（内部跳转，不需导出） -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="false" />

    </application>
</manifest>