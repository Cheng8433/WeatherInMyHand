<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：控制台 + 滚动文件。
  为什么需要它：原先只靠 application.properties 的 logging.file.name 写单文件，
  logback 默认不滚动，systemd 长期运行会把日志堆到无穷大。这里按天 + 按大小切分、
  压缩归档并限制总量与保留天数。

  级别仍以 application.properties 的 logging.level.* 为准（Spring Boot 在加载配置后会
  用这些属性覆盖 logger 级别），因此 application-dev.properties 里的 DEBUG 依旧生效。
-->
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/weather-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件名带日期与序号，配合 gzip 压缩，避免磁盘被日志吃满 -->
            <fileNamePattern>${LOG_DIR}/archive/weather-app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
